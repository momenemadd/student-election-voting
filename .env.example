# Copy to backend/.env and fill in. NEVER commit backend/.env.
# --- Database (Neon). Use the POOLED string ("-pooler" in the host) for the app.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# --- Auth: at least 32 random chars, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_VALUE_AT_LEAST_32_CHARS

# --- CORS: exact origin(s) of the frontend, comma separated, no trailing slash
CORS_ORIGINS=http://localhost:8080,http://localhost:4566

# --- Cloudflare Turnstile. These are Cloudflare's published TEST keys (always pass); replace for real use.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
TURNSTILE_BYPASS=false

# --- Email provider (Brevo): API key + the verified sender address
MAIL_API_KEY=
MAIL_FROM=

# --- Seed accounts (used by `npm run seed`, >= 12 chars)
SEED_ADMIN_EMAIL=admin@example.edu
SEED_ADMIN_PASSWORD=
SEED_AUDITOR_EMAIL=auditor@example.edu
SEED_AUDITOR_PASSWORD=

# --- Set only on Floci / AWS (Lambda gets these as environment variables)
# SECRETS_ID=election/app-secrets     # JSON secret with DATABASE_URL, JWT_SECRET, TURNSTILE_SECRET_KEY, MAIL_API_KEY
# AUDIT_TABLE=AuditLog                # DynamoDB audit store; if unset, Postgres table audit_log is used
# NODE_ENV=production
